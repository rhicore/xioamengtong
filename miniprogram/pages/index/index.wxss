.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
}

.hero-card {
  padding: 34rpx 8rpx 42rpx;
}

.eyebrow {
  color: #9ca3af;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 20rpx;
  color: #111827;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.form-card {
  padding: 36rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(17, 24, 39, 0.06);
}

.label {
  color: #374151;
  font-size: 26rpx;
  font-weight: 700;
}

.order-input {
  height: 104rpx;
  margin-top: 18rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  color: #111827;
  font-size: 30rpx;
}

.order-input:focus {
  border-color: #111827;
}

.placeholder {
  color: #9ca3af;
}

.submit-button {
  height: 104rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 20rpx;
  background: #111827;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 104rpx;
}

.submit-button.is-disabled {
  background: #d1d5db;
  color: #ffffff;
}

.error-message {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 2rpx solid #fee2e2;
  border-radius: 16rpx;
  background: #fef2f2;
  color: #dc2626;
  font-size: 24rpx;
  line-height: 1.5;
}
